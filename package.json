{
  "name": "spryte",
  "version": "0.1.0",
  "description": "Small, fast 2D renderer for the web: batched WebGL2 sprites, shapes and text, with an automatic Canvas 2D fallback",
  "keywords": [
    "2d",
    "renderer",
    "webgl2",
    "canvas",
    "sprites",
    "batching",
    "pixel-art",
    "gamedev",
    "html5-game",
    "browser-game"
  ],
  "license": "MIT",
  "homepage": "https://debuff.jp",
  "bugs": "https://github.com/debuffjp/debuff/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/debuffjp/debuff.git",
    "directory": "packages/spryte"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "publishConfig": {
    "access": "public"
  }
}
