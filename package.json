{
  "name": "spryte",
  "version": "0.1.0",
  "description": "Verifiably fast 2D WebGL2 renderer: moving sprites 2–4× faster than the most widely used web renderer, in an open, pixel-checked benchmark. ~10 kB, Canvas 2D fallback.",
  "keywords": [
    "2d",
    "renderer",
    "webgl2",
    "canvas",
    "sprites",
    "batching",
    "pixel-art",
    "gamedev",
    "html5-game",
    "browser-game"
  ],
  "license": "MIT",
  "homepage": "https://github.com/debuffjp/spryte#readme",
  "bugs": "https://github.com/debuffjp/spryte/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/debuffjp/spryte.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "example": "vite examples/minimal",
    "test:browser": "node browser-test/run.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "happy-dom": "^21.0.3",
    "playwright-core": "1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
