{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "spryte": ["../../src/index.ts"],
      "spryte/pixi": ["../../src/pixi.ts"]
    }
  },
  "include": ["*.ts"]
}
